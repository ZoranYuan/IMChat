{
  "info": {
    "_postman_id": "d7b4f4a5-4f08-4f4c-8bd1-4c8f0d42b4a1",
    "name": "IMChat API",
    "description": "根据 backend/internal/transport/http 与 backend/internal/transport/ws 当前实现整理。HTTP 成功响应统一为 {code: 200, message: \"success\", data: ...}；登录后服务端通过 HttpOnly Cookie 保存 access_token/refresh_token，也支持 Authorization: Bearer <access_token>。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api/v1" },
    { "key": "healthUrl", "value": "http://localhost:8081/healthz" },
    { "key": "liveUrl", "value": "http://localhost:8081/livez" },
    { "key": "readyUrl", "value": "http://localhost:8081/readyz" },
    { "key": "token", "value": "REPLACE_ACCESS_TOKEN" },
    { "key": "userId", "value": "REPLACE_USER_ID" },
    { "key": "roomId", "value": "REPLACE_ROOM_ID" },
    { "key": "conversationId", "value": "REPLACE_CONVERSATION_ID" },
    { "key": "attachmentId", "value": "REPLACE_ATTACHMENT_ID" },
    { "key": "uploadId", "value": "REPLACE_UPLOAD_ID" },
    { "key": "requestId", "value": "REPLACE_REQUEST_ID" },
    { "key": "fromUserId", "value": "REPLACE_FROM_USER_ID" },
    { "key": "targetUserId", "value": "REPLACE_TARGET_USER_ID" },
    { "key": "inviteCode", "value": "REPLACE_INVITE_CODE" },
    { "key": "fileId", "value": "REPLACE_FILE_ID" },
    { "key": "presignedUrl", "value": "REPLACE_PRESIGNED_URL" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "系统模块",
      "item": [
        {
          "name": "存活检查",
          "request": { "method": "GET", "url": "{{liveUrl}}", "auth": { "type": "noauth" } }
        },
        {
          "name": "健康检查",
          "request": { "method": "GET", "url": "{{healthUrl}}", "auth": { "type": "noauth" } }
        },
        {
          "name": "就绪检查",
          "request": { "method": "GET", "url": "{{readyUrl}}", "auth": { "type": "noauth" } }
        }
      ]
    },
    {
      "name": "账户模块",
      "item": [
        {
          "name": "用户注册（手机号）",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\",\n  \"reconfirmPassword\": \"123456\",\n  \"loginType\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/register"
          }
        },
        {
          "name": "用户登录（手机号）",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\",\n  \"loginType\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/login"
          }
        },
        {
          "name": "刷新登录会话",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "description": "依赖 refresh_token HttpOnly Cookie，成功后会重新下发两个 Cookie。",
            "url": "{{baseUrl}}/users/refresh"
          }
        },
        {
          "name": "解析用户（手机号或关键词）",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/resolve?keyword=13800138000"
          }
        },
        {
          "name": "获取用户信息",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" }
        },
        {
          "name": "退出登录",
          "request": { "method": "POST", "url": "{{baseUrl}}/users/logout" }
        }
      ]
    },
    {
      "name": "好友模块",
      "item": [
        {
          "name": "好友列表",
          "request": { "method": "GET", "url": "{{baseUrl}}/friends" }
        },
        {
          "name": "发送好友申请",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{targetUserId}}\",\n  \"message\": \"你好，添加一下好友\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/friend-requests"
          }
        },
        {
          "name": "好友申请列表",
          "request": { "method": "GET", "url": "{{baseUrl}}/friend-requests" }
        },
        {
          "name": "同意好友申请",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"fromUserId\": \"{{fromUserId}}\",\n  \"action\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/friend-requests/actions"
          }
        },
        {
          "name": "拒绝好友申请",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"fromUserId\": \"{{fromUserId}}\",\n  \"action\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/friend-requests/actions"
          }
        }
      ]
    },
    {
      "name": "房间模块",
      "item": [
        {
          "name": "创建房间",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"项目群\",\n  \"description\": \"项目协作讨论\",\n  \"avatar\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rooms"
          }
        },
        {
          "name": "获取房间邀请码",
          "request": { "method": "GET", "url": "{{baseUrl}}/rooms/{{roomId}}/invite-code" }
        },
        {
          "name": "通过邀请码加入房间",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rooms/join"
          }
        },
        {
          "name": "退出房间",
          "request": { "method": "POST", "url": "{{baseUrl}}/rooms/{{roomId}}/leave" }
        }
      ]
    },
    {
      "name": "文件模块",
      "description": "后端只提供上传初始化、预签名地址和完成接口；实际文件字节由客户端直接 PUT 到对象存储预签名 URL。允许的 Content-Type：image/jpeg、image/png、image/webp、video/mp4、application/pdf、text/plain。",
      "item": [
        {
          "name": "初始化直传",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"demo.png\",\n  \"contentType\": \"image/png\",\n  \"size\": 1024,\n  \"fileHash\": \"SHA256_HEX\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/files/direct/init"
          }
        },
        {
          "name": "直传对象存储（预签名 PUT）",
          "request": {
            "method": "PUT",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "image/png" }],
            "body": { "mode": "file", "file": { "src": "/path/to/demo.png" } },
            "url": "{{presignedUrl}}"
          }
        },
        {
          "name": "完成直传",
          "request": { "method": "POST", "url": "{{baseUrl}}/files/direct/{{uploadId}}/complete" }
        },
        {
          "name": "初始化分片上传",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"demo.mp4\",\n  \"contentType\": \"video/mp4\",\n  \"size\": 10485760,\n  \"fileHash\": \"SHA256_HEX_OR_FINGERPRINT\",\n  \"chunkSize\": 5242880,\n  \"totalChunks\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/files/multipart/init"
          }
        },
        {
          "name": "批量获取分片预签名地址",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partNumbers\": [1, 2]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/files/multipart/{{uploadId}}/parts/presign"
          }
        },
        {
          "name": "上传分片（预签名 PUT）",
          "request": {
            "method": "PUT",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/octet-stream" }],
            "body": { "mode": "file", "file": { "src": "/path/to/chunk.bin" } },
            "url": "{{presignedUrl}}"
          }
        },
        {
          "name": "完成分片上传",
          "request": { "method": "POST", "url": "{{baseUrl}}/files/multipart/{{uploadId}}/complete" }
        },
        {
          "name": "获取附件访问地址",
          "request": { "method": "GET", "url": "{{baseUrl}}/files/attachments/{{attachmentId}}/access-url" }
        }
      ]
    },
    {
      "name": "会话模块",
      "item": [
        {
          "name": "获取会话列表",
          "request": {
            "method": "GET",
            "description": "返回当前用户的私聊/群聊侧边栏快照、最后一条消息和未读数，不返回离线期间全部消息。",
            "url": "{{baseUrl}}/conversations"
          }
        }
      ]
    },
    {
      "name": "消息模块",
      "item": [
        {
          "name": "历史消息",
          "request": {
            "method": "GET",
            "description": "cursor=0 获取最新一页，之后将 nextCursor 作为 cursor 获取更早消息；limit 受服务端配置限制。",
            "url": "{{baseUrl}}/messages/history?conversationId={{conversationId}}&cursor=0&limit=30"
          }
        },
        {
          "name": "增量同步消息",
          "request": {
            "method": "GET",
            "description": "返回 seq > afterSeq 的完整消息，按 seq 正序返回。",
            "url": "{{baseUrl}}/messages/sync?conversationId={{conversationId}}&afterSeq=0&limit=50"
          }
        },
        {
          "name": "房间历史视频",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/messages/videos?roomId={{roomId}}&limit=20"
          }
        },
        {
          "name": "弹幕回放",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/messages/danmaku?roomId={{roomId}}&videoId={{fileId}}&startTime=0&endTime=0&limit=200"
          }
        }
      ]
    },
    {
      "name": "实时通道",
      "item": [
        {
          "name": "WebSocket 连接",
          "request": {
            "method": "GET",
            "description": "通过 Authorization: Bearer <access_token> 或 access_token Cookie 握手；前端使用 ?batch=1，服务端返回 protobuf 二进制帧。客户端操作：msg(messageReq)、msg_read_ack(readAck)；大群可能收到 room_msg_notice，随后调用消息增量同步接口。",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "ws://localhost:8081/api/v1/ws?batch=1"
          }
        }
      ]
    }
  ]
}

{
  "info": {
    "_postman_id": "d7b4f4a5-4f08-4f4c-8bd1-4c8f0d42b4a1",
    "name": "SYCHAT API",
    "description": "SYCHAT backend API collection for Apipost import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "REPLACE_ME" },
    { "key": "userId", "value": "REPLACE_USER_ID" },
    { "key": "roomId", "value": "REPLACE_ROOM_ID" },
    { "key": "conversationId", "value": "REPLACE_CONVERSATION_ID" },
    { "key": "fileId", "value": "REPLACE_FILE_ID" },
    { "key": "uploadId", "value": "REPLACE_UPLOAD_ID" },
    { "key": "partNumber", "value": "1" },
    { "key": "inviteCode", "value": "REPLACE_INVITE_CODE" },
    { "key": "requestId", "value": "REPLACE_REQUEST_ID" },
    { "key": "targetUserId", "value": "REPLACE_TARGET_USER_ID" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "账户模块",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\",\n  \"reconfirmPassword\": \"123456\",\n  \"loginType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/register"
          }
        },
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\",\n  \"loginType\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/login"
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/logout"
          }
        },
        {
          "name": "获取用户信息",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "解析用户",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/resolve?keyword=13800138000"
          }
        }
      ]
    },
    {
      "name": "好友模块",
      "item": [
        {
          "name": "好友列表",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/friends"
          }
        },
        {
          "name": "发送好友申请",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"{{targetUserId}}\",\n  \"message\": \"你好，添加一下好友\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/friend-requests"
          }
        },
        {
          "name": "好友申请列表",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/friend-requests"
          }
        },
        {
          "name": "处理好友申请",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"action\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/friend-requests/actions"
          }
        }
      ]
    },
    {
      "name": "房间模块",
      "item": [
        {
          "name": "创建房间",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"项目群\",\n  \"description\": \"项目协作讨论\",\n  \"avatar\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/rooms"
          }
        },
        {
          "name": "获取房间邀请码",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rooms/{{roomId}}/invite-code"
          }
        },
        {
          "name": "通过邀请码加入房间",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/rooms/join"
          }
        }
      ]
    },
    {
      "name": "视频模块",
      "item": [
        {
          "name": "上传视频文件",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/video.mp4"
                }
              ]
            },
            "url": "{{baseUrl}}/files"
          }
        },
        {
          "name": "初始化分片上传",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"demo.mp4\",\n  \"contentType\": \"video/mp4\",\n  \"size\": 10485760,\n  \"chunkSize\": 5242880,\n  \"totalChunks\": 2,\n  \"fileHash\": \"demo-file-hash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/files/multipart/init"
          }
        },
        {
          "name": "上传分片",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "chunk",
                  "type": "file",
                  "src": "/path/to/chunk.bin"
                },
                {
                  "key": "chunkHash",
                  "type": "text",
                  "value": "demo-chunk-hash"
                }
              ]
            },
            "url": "{{baseUrl}}/files/multipart/{{uploadId}}/parts/{{partNumber}}"
          }
        },
        {
          "name": "完成分片上传",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/files/multipart/{{uploadId}}/complete"
          }
        },
        {
          "name": "获取视频文件",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/files/{{fileId}}"
          }
        }
      ]
    },
    {
      "name": "会话模块",
      "item": [
        {
          "name": "获取会话列表",
          "request": {
            "method": "GET",
            "description": "登录成功、页面初始化、手动刷新或 WebSocket 重连成功后调用。返回会话最后一条消息和未读数，不返回离线期间的全部消息。",
            "url": "{{baseUrl}}/conversations"
          }
        }
      ]
    },
    {
      "name": "消息模块",
      "item": [
        {
          "name": "历史消息",
          "request": {
            "method": "GET",
            "description": "用户打开会话时调用。cursor=0 获取最新一页，之后使用 nextCursor 加载更早消息。",
            "url": "{{baseUrl}}/messages/history?conversationId={{conversationId}}&cursor=0&limit=20"
          }
        },
        {
          "name": "房间历史视频",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/messages/videos?roomId={{roomId}}&limit=20"
          }
        },
        {
          "name": "弹幕回放",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/messages/danmaku?roomId={{roomId}}&videoId={{fileId}}&startTime=0&endTime=0&limit=200"
          }
        }
      ]
    },
    {
      "name": "实时通道",
      "item": [
        {
          "name": "WebSocket 连接",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "ws://localhost:8080/api/v1/ws?token={{token}}"
          }
        }
      ]
    }
  ]
}

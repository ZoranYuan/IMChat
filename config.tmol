# ~/.codex/config.toml
model = "gpt-5.6-luna"
model_provider = "agentrouter"
model_reasoning_effort = "medium"
approvals_reviewer = "user"

[model_providers.agentrouter]
supports_websockets = false
name = "agentrouter"
base_url = "https://tsyjzzz.com/v1"
env_key = "AGENT_ROUTER_TOKEN"
wire_api = "responses"
query_params = {}
stream_idle_timeout_ms = 300000

approvals_reviewer = "user"
[projects."/workspace"]
trust_level = "trusted"

[projects."/workspace/IM"]
trust_level = "trusted"

[projects."/workspace/feedsystem_video_go"]
trust_level = "trusted"

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 4

[notice]
hide_full_access_warning = true
